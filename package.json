{
  "name": "canvas-arbor",
  "version": "0.3.2",
  "description": "Build mind maps on Canvas from the keyboard: Enter and Tab add nodes, Shift+arrow moves between them, branches collapse and stay balanced, maps grow right, on both sides or downward, nodes fit their text.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "monkey-around": "^3.0.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
