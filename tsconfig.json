{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2018",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "lib": ["DOM", "DOM.Iterable", "ES2021"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
